{
  "name": "back-nestjs-boilerplate",
  "version": "0.0.2",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "format": "biome check --write src",
    "format:check": "biome check src",
    "lint": "biome check --write src",
    "lint:check": "biome check src",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage=true",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "mikro-orm:migration:create": "npx mikro-orm migration:create",
    "prepare": "husky"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/decorators": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/cqrs": "12.1.0",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "^18.0.7",
    "elastic-apm-node": "4.18.0",
    "envalid": "^8.2.0",
    "fastify": "5.12.5",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@mikro-orm/cli": "7.2.5",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "26.6.5",
    "@vitest/coverage-istanbul": "5.0.3",
    "husky": "9.1.7",
    "source-map-support": "0.5.21",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "mikro-orm": {
    "preferTs": true,
    "configPaths": [
      "./src/config/infrastructure/mikroOrm/MikroOrmCliConfig.ts",
      "./dist/config/infrastructure/mikroOrm/MikroOrmCliConfig.js"
    ]
  }
}
